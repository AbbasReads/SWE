digraph L0 { rankdir=LR;
  graph [fontname="Noto Sans", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=1.1, splines=true];
  node  [fontname="Noto Sans", fontsize=13, color="#18181B", fontcolor="#18181B", penwidth=1.3];
  edge  [fontname="Noto Sans", fontsize=11, color="#52525B", fontcolor="#52525B", arrowsize=0.7, penwidth=1.1];
  M [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Show Manager"];
  SPC [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Spectator"];
  SP [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Sales Person"];
  AC [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Accounts Clerk"];
  P [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=2.4, label=<<FONT POINT-SIZE="11" COLOR="#9F1239">0</FONT><BR/><B>Students' Auditorium<BR/>Management<BR/>Software</B>>];
  {rank=same; M; SPC}  {rank=same; SP; AC}
  M -> P   [label="show details, prices,\nseat quotas, sales accounts"];
  M -> P   [dir=back, label="statistics, commission,\nbalance sheets"];
  SPC -> P [label="availability query"];
  SPC -> P [dir=back, label="seats available"];
  P -> SP  [dir=back, label="login, booking,\ncancellation request"];
  P -> SP  [label="printed ticket,\nrefund amount"];
  P -> AC  [dir=back, label="show expenditure"];
  P -> AC  [label="confirmation"];
}
