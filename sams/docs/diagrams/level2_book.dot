digraph L2b { rankdir=TB; ranksep=0.9; nodesep=0.6;
  graph [fontname="Noto Sans", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=1.1, splines=true];
  node  [fontname="Noto Sans", fontsize=16, color="#18181B", fontcolor="#18181B", penwidth=1.3];
  edge  [fontname="Noto Sans", fontsize=15, color="#52525B", fontcolor="#52525B", arrowsize=0.7, penwidth=1.1];
  SP [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Sales Person"];
  P31 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.75, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.1</FONT><BR/>Validate<BR/>request>];
  P32 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.75, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.2</FONT><BR/>Lock show,<BR/>check seats>];
  P33 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.75, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.3</FONT><BR/>Allocate<BR/>seat numbers>];
  P34 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.75, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.4</FONT><BR/>Record<BR/>sale>];
  P35 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.75, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.5</FONT><BR/>Print<BR/>ticket>];
  D2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D2</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Shows</TD></TR></TABLE>>];
  D3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D3</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Tickets</TD></TR></TABLE>>];
  SP -> P31  [label="show, class, qty"];
  P31 -> P32 [label="valid request"];
  D2 -> P32  [label="seats for sale\n(FOR UPDATE)"];
  D3 -> P32  [label="booked count"];
  P32 -> P33 [label="seats free"];
  P33 -> P34 [label="seat no, price"];
  P34 -> D3  [label="ticket, sales person id"];
  P35 -> P34 [dir=back, label="ticket"];
  P35 -> SP [label="printed ticket", constraint=false];
  {rank=same; SP; P31; P32; P33}
  {rank=same; P35; P34; D3; D2}
  P35 -> P34 -> D3 -> D2 [style=invis];
  SP -> P31 -> P32 -> P33 [style=invis];
}
