digraph L1 { rankdir=TB; ranksep=1.0; nodesep=0.3;
  graph [fontname="Noto Sans", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=1.1, splines=true];
  node  [fontname="Noto Sans", fontsize=18, color="#18181B", fontcolor="#18181B", penwidth=1.3];
  edge  [fontname="Noto Sans", fontsize=19, color="#52525B", fontcolor="#52525B", arrowsize=0.7, penwidth=1.1];
  M [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Show Manager"];
  SP [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Sales Person"];
  SPC [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Spectator"];
  AC [shape=box, style="filled", fillcolor="#F4F4F5", width=1.8, height=0.7, label="Accounts Clerk"];
  P1 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">1.0</FONT><BR/>Login &amp;<BR/>accounts>];
  P2 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">2.0</FONT><BR/>Configure<BR/>shows>];
  P3 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">3.0</FONT><BR/>Book<BR/>tickets>];
  P4 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">4.0</FONT><BR/>Cancel &amp;<BR/>refund>];
  P5 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">5.0</FONT><BR/>Query<BR/>availability>];
  P6 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">6.0</FONT><BR/>Record<BR/>expenditure>];
  P7 [shape=circle, style="filled", fillcolor="#FFF1F2", color="#9F1239", fixedsize=true, width=1.9, label=<<FONT POINT-SIZE="13" COLOR="#9F1239">7.0</FONT><BR/>Generate<BR/>reports>];
  D1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D1</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Users</TD></TR></TABLE>>];
  D2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D2</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Shows</TD></TR></TABLE>>];
  D3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D3</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Tickets</TD></TR></TABLE>>];
  D4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#71717A"><TR><TD SIDES="TBL" BGCOLOR="#F4F4F5"><B>D4</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Expenditures</TD></TR></TABLE>>];
  {rank=same; M; SP; SPC; AC}
  M -> SP -> SPC -> AC [style=invis];
  SP -> P1 [style=invis];
  {rank=same; P2; P7; P1}
  {rank=same; P3; P4; P5; P6}
  P2 -> P7 -> P1 [style=invis];
  P3 -> P4 -> P5 -> P6 [style=invis];
  P7 -> P4 [style=invis];
  {rank=same; D1; D2; D3; D4}
  D1 -> D2 -> D3 -> D4 [style=invis];
  M -> P1  [label="login,\nnew account"];
  SP -> P1 [label="credentials"];
  AC -> P1 [label="credentials"];
  P1 -> D1 [dir=both, label="user, role"];
  M -> P2  [label="show setup"];
  P2 -> D2 [label="show config"];
  SP -> P3 [label="show, class, qty"];
  P3 -> D3 [label="ticket, seller id"];
  P3 -> D2 [dir=back, label="price, seats"];
  SP -> P4 [label="ticket no"];
  P4 -> D3 [dir=both, label="ticket, refund"];
  P4 -> D2 [dir=back, label="show date"];
  SPC -> P5 [label="show, class"];
  P5 -> D2 [dir=back, label="seats for sale"];
  P5 -> D3 [dir=back, label="booked"];
  AC -> P6 [label="expenditure"];
  P6 -> D4 [label="expense"];
  M -> P7  [label="report query"];
  P7 -> D3 [dir=back, label="sales"];
  P7 -> D4 [dir=back, label="expenses"];
  P7 -> D1 [dir=back, label="commission rate"];
  M -> P7  [dir=back, label="reports"];
  SP -> P3 [dir=back, label="printed ticket"];
  SP -> P4 [dir=back, label="refund amount"];
  SPC -> P5 [dir=back, label="seats available"];
}
