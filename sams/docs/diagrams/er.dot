digraph ER { rankdir=LR; nodesep=0.6; ranksep=0.9; bgcolor="white"; pad=0.3;
node [shape=plaintext, fontname="Noto Sans", fontsize=17];
edge [color="#52525B", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2, fontname="Noto Sans", fontsize=13, fontcolor="#52525B"];
users [label=<<TABLE BORDER="1" COLOR="#D4D4D8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#F4F4F5" ALIGN="LEFT"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#9F1239">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239">username</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">password</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">role</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">ENUM(manager, sales, clerk)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">commission_rate</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(5,4)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR></TABLE>>];
shows [label=<<TABLE BORDER="1" COLOR="#D4D4D8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#F4F4F5" ALIGN="LEFT"><B>shows</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_l"><FONT COLOR="#9F1239"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#9F1239">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">title</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239">date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239">UQ₁</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239">timing</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">TIME</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239">UQ₁</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">balcony_price</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">ordinary_price</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">balcony_seats</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">ordinary_seats</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">comp_balcony</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">comp_ordinary</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR></TABLE>>];
tickets [label=<<TABLE BORDER="1" COLOR="#D4D4D8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#F4F4F5" ALIGN="LEFT"><B>tickets</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#9F1239">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="show_id"><FONT COLOR="#9F1239">show_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT" PORT="show_id_r"><FONT COLOR="#9F1239">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">category</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">ENUM(balcony, ordinary)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">seat_no</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">price</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">booking_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="salesperson_id"><FONT COLOR="#9F1239">salesperson_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">ENUM(BOOKED, CANCELLED)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">refund</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR></TABLE>>];
expenditures [label=<<TABLE BORDER="1" COLOR="#D4D4D8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#F4F4F5" ALIGN="LEFT"><B>expenditures</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9F1239"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#9F1239">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="show_id"><FONT COLOR="#9F1239">show_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#18181B">date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#71717A">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9F1239"> </FONT></TD></TR></TABLE>>];
users:id:e -> tickets:salesperson_id:w [label="sells"];
tickets:show_id_r:e -> shows:id_l:w [label="has", arrowhead=tee, arrowtail=crow];
shows:id:e -> expenditures:show_id:w [label="incurs"];
}